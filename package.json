{
  "name": "pulsewatch",
  "version": "1.0.0",
  "private": true,
  "description": "PulseWatch - Enterprise-grade API Monitoring & Incident Management Platform",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:frontend": "pnpm --filter @pulsewatch/frontend dev",
    "dev:backend": "pnpm --filter @pulsewatch/backend dev",
    "dev:scheduler": "pnpm --filter @pulsewatch/scheduler dev",
    "dev:worker": "pnpm --filter @pulsewatch/worker dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:system": "tsx test/system-verification.ts",
    "test:slack": "tsx test/test-slack.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "tsx": "^4.23.15",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
