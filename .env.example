# ==========================================
# 1. DATABASE (Production Supabase)
# ==========================================
DATABASE_URL="postgresql://postgres.[PROD_REF]:[PROD_PW]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20"
DIRECT_URL="postgresql://postgres.[PROD_REF]:[PROD_PW]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# ==========================================
# 2. RUNTIME ENVIRONMENT
# ==========================================
NODE_ENV=production
APP_NAME=PulseWatch
APP_ENV=production
LOG_LEVEL=info

# ==========================================
# 3. DOMAINS & CORS (Public URLs)
# ==========================================
NEXT_PUBLIC_APP_NAME=PulseWatch
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
WEB_ORIGIN=https://yourdomain.com
API_PUBLIC_URL=https://api.yourdomain.com

# ==========================================
# 4. REDIS (Internal or Managed)
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# 5. NEW CRYPTOGRAPHIC SECRETS (Generate new)
# ==========================================
JWT_ACCESS_SECRET=[NEW_32_BYTE_HEX_KEY]
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=pulsewatch
JWT_AUDIENCE=pulsewatch-api

REFRESH_TOKEN_PEPPER=[NEW_32_BYTE_HEX_KEY]
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

ENCRYPTION_KEY=[NEW_32_BYTE_BASE64_KEY]
ENCRYPTION_KEY_VERSION=v1

# ==========================================
# 6. PORTS & TUNING
# ==========================================
PORT=4001
API_PORT=4001
HOST_API_PORT=4001
HOST_WEB_PORT=3001

MONITOR_DEFAULT_INTERVAL_SECONDS=60
MONITOR_DEFAULT_TIMEOUT_MS=10000
MONITOR_MAX_TIMEOUT_MS=30000
MONITOR_FAILURE_THRESHOLD=3
MONITOR_RECOVERY_THRESHOLD=2

SCHEDULER_POLL_INTERVAL_MS=5000
SCHEDULER_BATCH_SIZE=500
SCHEDULER_LEASE_DURATION_MS=60000

MONITOR_WORKER_CONCURRENCY=10
MONITOR_MAX_RESPONSE_BYTES=1048576
MONITOR_MAX_REDIRECTS=0

# ==========================================
# 8. SLACK ALERTS (Option 1: Global Webhook)
# ==========================================
# Paste your Slack Incoming Webhook URL here to receive real-time incident alerts
SLACK_WEBHOOK_URL=