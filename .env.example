# ==========================================
# 1. DATABASE (Supabase or Local PostgreSQL)
# ==========================================
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.[db-ref]:[password]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.[db-ref]:[password]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# ==========================================
# 2. RUNTIME ENVIRONMENT
# ==========================================
NODE_ENV=development
APP_NAME=PulseWatch
APP_ENV=development
LOG_LEVEL=info

# ==========================================
# 3. PORTS & DOMAINS
# ==========================================
FRONTEND_PORT=3000
BACKEND_PORT=4001
PORT=4001
API_PORT=4001

# Public & CORS URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4001/api/v1
CORS_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1

# ==========================================
# 4. REDIS (Job Queue Broker)
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# 5. CRYPTOGRAPHIC SECRETS (Min 32 characters)
# ==========================================
JWT_ACCESS_SECRET=pulsewatch_dev_jwt_access_secret_key_minimum_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=pulsewatch
JWT_AUDIENCE=pulsewatch-api

REFRESH_TOKEN_PEPPER=pulsewatch_dev_refresh_token_pepper_secret_32_chars_min
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

ENCRYPTION_KEY=pulsewatch_encryption_key_32_chars_min
ENCRYPTION_KEY_VERSION=v1

# ==========================================
# 6. MONITORING & SCHEDULER TUNING
# ==========================================
MONITOR_DEFAULT_INTERVAL_SECONDS=60
MONITOR_DEFAULT_TIMEOUT_MS=10000
MONITOR_MAX_TIMEOUT_MS=30000
MONITOR_FAILURE_THRESHOLD=3
MONITOR_RECOVERY_THRESHOLD=2

SCHEDULER_POLL_INTERVAL_MS=5000
SCHEDULER_BATCH_SIZE=500
SCHEDULER_LEASE_DURATION_MS=60000
MONITOR_WORKER_CONCURRENCY=10
MONITOR_MAX_RESPONSE_BYTES=1048576

# ==========================================
# 7. NOTIFICATIONS (Optional)
# ==========================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
