{
  "name": "@pulsewatch/database",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "clean": "rimraf dist",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@pulsewatch/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.8",
    "dotenv-cli": "^11.1.0",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  }
}
